[
  {
    "name": "theme_info",
    "theme_name": "Atelier Base",
    "theme_version": "0.1.0",
    "theme_author": "Atelier",
    "theme_documentation_url": "https://shopifyapp-production-8587.up.railway.app",
    "theme_support_url": "https://shopifyapp-production-8587.up.railway.app"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface",
        "info": "Cards, panels, alternating sections",
        "default": "#F6F5F2"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#1A1A1A"
      },
      {
        "type": "color",
        "id": "color_text_subdued",
        "label": "Subdued text",
        "default": "#5C5C5C"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "#1A1A1A"
      },
      {
        "type": "color",
        "id": "color_on_accent",
        "label": "Text on accent",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Borders",
        "default": "#E3E1DC"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Heading font",
        "default": "assistant_n4"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Heading size scale",
        "min": 100,
        "max": 160,
        "step": 5,
        "unit": "%",
        "default": 120
      },
      {
        "type": "range",
        "id": "body_size",
        "label": "Body size",
        "min": 14,
        "max": 19,
        "step": 1,
        "unit": "px",
        "default": 16
      },
      {
        "type": "range",
        "id": "heading_letter_spacing",
        "label": "Heading letter spacing",
        "info": "Thousandths of an em; negative = tighter",
        "min": -40,
        "max": 80,
        "step": 5,
        "default": -10
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1000,
        "max": 1600,
        "step": 40,
        "unit": "px",
        "default": 1280
      },
      {
        "type": "range",
        "id": "spacing_scale",
        "label": "Spacing scale",
        "min": 75,
        "max": 150,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "range",
        "id": "section_spacing",
        "label": "Section spacing",
        "info": "Vertical rhythm between sections, in spacing units",
        "min": 3,
        "max": 10,
        "step": 1,
        "default": 6
      }
    ]
  },
  {
    "name": "Style",
    "settings": [
      {
        "type": "range",
        "id": "corner_radius",
        "label": "Corner radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 8
      },
      {
        "type": "range",
        "id": "button_corner_radius",
        "label": "Button corner radius",
        "min": 0,
        "max": 32,
        "step": 2,
        "unit": "px",
        "default": 8
      },
      {
        "type": "select",
        "id": "button_style",
        "label": "Button style",
        "options": [
          { "value": "solid", "label": "Solid" },
          { "value": "outline", "label": "Outline" }
        ],
        "default": "solid"
      },
      {
        "type": "range",
        "id": "border_width",
        "label": "Border width",
        "min": 1,
        "max": 3,
        "step": 1,
        "unit": "px",
        "default": 1
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Will be scaled down to 32 x 32px"
      }
    ]
  }
]
