# Shopify app credentials (Partner Dashboard → app → Client credentials)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Public URL of the app (Railway deployment or tunnel during `shopify app dev`)
SHOPIFY_APP_URL=
# Comma-separated scopes; must match shopify.app.toml [access_scopes]
SCOPES=read_products,write_products,read_themes,write_themes,read_content,write_content,read_files,write_files,read_online_store_navigation,write_online_store_navigation,read_locales

# Supabase Postgres (pooled URL for the app, direct URL for migrations)
DATABASE_URL=
DIRECT_DATABASE_URL=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Generation engines (Phase 3)
ANTHROPIC_API_KEY=
FAL_KEY=

# Supabase Storage (theme zips, signed URLs — Phase 2)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
